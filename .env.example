# Copy backend settings to backend/.env; never commit .env.
DATABASE_URL=mysql+pymysql://gst:CHANGE_ME@127.0.0.1:3306/gst_billing
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
REGISTRATION_ENABLED=false
SECURE_COOKIES=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Frontend production: use a same-origin reverse proxy for cookie refresh.
# VITE_API_URL=/api/v1
